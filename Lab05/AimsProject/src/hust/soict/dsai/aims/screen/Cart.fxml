<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="768.0" prefWidth="1024.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml">

    <top>
        <VBox>
            <MenuBar>
                <menus>
                    <Menu text="Options">
                        <items>
                            <MenuItem text="View store" onAction="#viewStorePressed"/>
                            <MenuItem text="View cart"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <Label text="CART" textFill="AQUA" style="-fx-font-size: 50px;">
                <padding>
                    <Insets left="10"/>
                </padding>
            </Label>
        </VBox>
    </top>

    <center>
        <VBox>
            <padding>
                <Insets left="10"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding>
                    <Insets top="10" bottom="10"/>
                </padding>

                <Label text="Filter:"/>
                <TextField fx:id="tfFilter"/>

                <RadioButton fx:id="radioBtnFilterId" text="By ID" selected="true">
                    <toggleGroup>
                        <ToggleGroup fx:id="filterCategory"/>
                    </toggleGroup>
                </RadioButton>

                <RadioButton fx:id="radioBtnFilterTitle" text="By Title" toggleGroup="$filterCategory"/>
            </HBox>

            <TableView fx:id="tblMedia" columnResizePolicy="CONSTRAINED_RESIZE_POLICY">
                <columns>
                    <TableColumn fx:id="colMediaTitle" text="Title"/>
                    <TableColumn fx:id="colMediacategory" text="Category"/>
                    <TableColumn fx:id="colMediaCost" text="Cost"/>
                </columns>
            </TableView>

            <ButtonBar>
                <buttons>
                    <Button fx:id="btnPlay" text="Play" onAction="#playButtonPressed"/>
                    <Button fx:id="btnRemove" text="Remove" onAction="#removeButtonPressed"/>
                </buttons>
            </ButtonBar>
        </VBox>
    </center>

    <right>
        <VBox alignment="TOP_CENTER" spacing="20">
            <padding>
                <Insets top="50"/>
            </padding>

            <HBox alignment="CENTER" spacing="10">
                <Label text="Total:" style="-fx-font-size: 24px;"/>
                <Label fx:id="totalCostLabel" text="0 $" textFill="AQUA" style="-fx-font-size: 24px;"/>
            </HBox>

            <Button text="Place order"
                    onAction="#placeOrderPressed"
                    textFill="WHITE"
                    style="-fx-font-size: 24px; -fx-background-color: red;"/>
        </VBox>
    </right>
</BorderPane>